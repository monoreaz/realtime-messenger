POSTGRES_USER=messenger
POSTGRES_PASSWORD=change_me
POSTGRES_DB=messenger
# Least-privilege roles (ops/db/least-privilege.sql). URL-safe values: `openssl rand -hex 24`.
# Set BOTH user and password of a role; while unset, the bootstrap superuser is used.
#APP_DB_USER=messenger_app
#APP_DB_PASSWORD=
#MIGRATOR_DB_USER=messenger_migrator
#MIGRATOR_DB_PASSWORD=

# At least 32 random bytes, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=change_me
# Access tokens are short-lived; the refresh cookie renews them.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public address used in e-mail links. The tailnet address keeps working as well.
PUBLIC_APP_URL=https://chat.slaxz.com
EMAIL_VERIFICATION_EXPIRE_MINUTES=30

REFRESH_TOKEN_SESSION_HOURS=24
REFRESH_COOKIE_NAME=messenger_refresh
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

REFRESH_TOKEN_REMEMBER_DAYS=30

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Messenger

PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Abuse protection (in-process limits; see backend/app/core/rate_limit.py).
RATE_LIMIT_ENABLED=true
# Same-origin deployment needs no CORS. Local Vite dev server: http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Interactive API docs (/api/docs); keep off in production.
ENABLE_API_DOCS=false

# Android push: see android/PUSH_SETUP.md
PUSH_ENABLED=false

# Authenticated TURN relay (coturn, profile "calls"); secret is secrets/turn-secret.
# Public name first; the tailnet address helps clients on the server's LAN when the
# router has no NAT loopback.
TURN_URLS=turn:turn.slaxz.com:3478?transport=udp,turn:turn.slaxz.com:3478?transport=tcp,turn:100.91.201.40:3478?transport=udp

# Services in optional profiles that `docker compose up -d` should manage:
# calls = coturn, tunnel = cloudflared (needs secrets/cloudflared-token).
COMPOSE_PROFILES=calls,tunnel
