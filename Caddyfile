{
	servers :80 {
		# Tailnet entry point. Requests reach this listener only from tailscale serve on this
		# host, through the Docker port mapping on 127.0.0.1:8080 (peer: loopback or the
		# messenger_default bridge gateway). tailscale serve (verified for 1.104.6,
		# ipn/ipnlocal/serve.go) drops any incoming X-Forwarded-For and sets it to the
		# connection's real source address, so the header holds exactly one value that
		# clients cannot forge. Only those peer ranges are trusted; tailnet, LAN and the
		# tunnel network are not, so a header sent by any other peer is ignored. Strict mode
		# takes the right-most untrusted address.
		trusted_proxies static 127.0.0.0/8 ::1/128 172.18.0.0/16
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
	servers :8081 {
		# Public entry point (https://chat.slaxz.com). Only cloudflared reaches this
		# listener: it is not published on the host and the "tunnel" network holds just
		# Caddy and cloudflared (fixed address 172.31.255.2, see compose.yml). Cloudflare's
		# edge sets Cf-Connecting-Ip to the visitor's address and overwrites any value the
		# visitor sends, so it is the only header trusted here.
		trusted_proxies static 172.31.255.2/32
		trusted_proxies_strict
		client_ip_headers Cf-Connecting-Ip
	}
}

# The whole site, served identically on both entry points; only the client-IP source
# differs (global options above).
(messenger) {
	# Security headers for the whole site (the API adds nosniff/no-referrer itself too).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://{host}; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle_path /api/* {
		# Body limits per route (same as backend/app/core/body_limit.py, which also
		# enforces them): uploads get their file size plus multipart overhead,
		# everything else is small JSON or form data. Caddy answers 413 itself.
		@video path_regexp ^/chats/[^/]+/messages/video$
		@image path_regexp ^/chats/[^/]+/messages/image$
		@avatar path /users/me/avatar
		@other not path_regexp ^/(chats/[^/]+/messages/(video|image)|users/me/avatar)$
		request_body @video {
			max_size 51MiB
		}
		request_body @image {
			max_size 11MiB
		}
		request_body @avatar {
			max_size 6MiB
		}
		request_body @other {
			max_size 256KiB
		}
		reverse_proxy backend:8000 {
			# One trusted value computed above, instead of a client-extendable chain.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /ws {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Static production build of the web app (frontend/dist, see compose.yml).
	handle {
		request_body {
			max_size 64KiB
		}
		root * /srv

		@apk path /downloads/*.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition attachment

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}

# Official website (https://slaxz.com): static Astro build from website/, published by
# website/scripts/deploy.sh into website/.deploy (mounted at /srv-website, see compose.yml).
# "current" is a symlink switched atomically on deploy, so no reload is needed.
(website) {
	header {
		# Own policy: no API/WebSocket, but the download buttons refresh from GitHub's API.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Cross-Origin-Opener-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 16KiB
	}
	root * /srv-website/current
	encode zstd gzip

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "public, max-age=300, must-revalidate"

	# Unknown paths get the site's 404 page with a real 404 status.
	@missing not file {path} {path}/index.html {path}.html
	handle @missing {
		rewrite * /404.html
		file_server {
			status 404
		}
	}
	handle {
		try_files {path} {path}/index.html {path}.html
		file_server
	}
}

# Host routing, identical on both entry points: the website for slaxz.com, a redirect for
# www.slaxz.com, and the messenger for every other host (chat.slaxz.com, the tailnet name).
(sites) {
	@website host slaxz.com
	handle @website {
		import website
	}
	@www host www.slaxz.com
	handle @www {
		redir https://slaxz.com{uri} permanent
	}
	handle {
		import messenger
	}
}

# Tailnet: tailscale serve -> 127.0.0.1:8080 -> here.
:80 {
	import sites
}

# Public: Cloudflare Tunnel -> cloudflared -> caddy:8081.
:8081 {
	import sites
}
