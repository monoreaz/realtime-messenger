{
	servers {
		# Requests reach Caddy only from tailscale serve on this host, through the Docker
		# port mapping on 127.0.0.1:8080 (peer: loopback or the Docker bridge gateway).
		# tailscale serve (verified for 1.104.6, ipn/ipnlocal/serve.go) drops any incoming
		# X-Forwarded-For and sets it to the connection's real source address, so the
		# header holds exactly one value that clients cannot forge. Only those two peer
		# ranges are trusted; tailnet and LAN addresses are not, so a header sent by any
		# other peer (e.g. if Caddy is ever exposed directly) is ignored. Strict mode takes
		# the right-most untrusted address.
		trusted_proxies static 127.0.0.0/8 ::1/128 172.16.0.0/12
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	# Security headers for the whole site (the API adds nosniff/no-referrer itself too).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://{host}; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle_path /api/* {
		# Body limits per route (same as backend/app/core/body_limit.py, which also
		# enforces them): uploads get their file size plus multipart overhead,
		# everything else is small JSON or form data. Caddy answers 413 itself.
		@video path_regexp ^/chats/[^/]+/messages/video$
		@image path_regexp ^/chats/[^/]+/messages/image$
		@avatar path /users/me/avatar
		@other not path_regexp ^/(chats/[^/]+/messages/(video|image)|users/me/avatar)$
		request_body @video {
			max_size 51MiB
		}
		request_body @image {
			max_size 11MiB
		}
		request_body @avatar {
			max_size 6MiB
		}
		request_body @other {
			max_size 256KiB
		}
		reverse_proxy backend:8000 {
			# One trusted value computed above, instead of a client-extendable chain.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /ws {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Static production build of the web app (frontend/dist, see compose.yml).
	handle {
		request_body {
			max_size 64KiB
		}
		root * /srv

		@apk path /downloads/*.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition attachment

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
