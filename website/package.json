{
  "name": "slaxz-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Official Slaxz website (slaxz.com). Independent of the messenger build.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "releases": "node scripts/fetch-releases.mjs",
    "build": "node scripts/fetch-releases.mjs && astro check && astro build",
    "preview": "astro preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.6",
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
