---
import { Image } from "astro:assets";
import brandMark from "../assets/brand-mark.webp";
import Icon from "./Icon.astro";
import { NAV, SITE } from "../site";
---

<header class="sticky top-0 z-50 px-4 pt-3 sm:px-6">
  <nav
    aria-label="Main"
    class="glass mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 rounded-full py-2 pr-2 pl-3"
  >
    <a href="/" class="flex items-center gap-2.5 rounded-full pr-2" aria-label="Slaxz home">
      <Image src={brandMark} densities={[1, 2]} alt="" width={36} height={36} class="size-9" loading="eager" />
      <span class="text-[17px] font-semibold tracking-tight">Slaxz</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-full px-3.5 py-2 text-[15px] font-medium text-ink-2 transition-colors duration-200 hover:bg-surface-2 hover:text-ink-1"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5">
      <a href={SITE.webApp} class="btn btn-primary min-h-10 px-4 text-sm">
        Open Slaxz
        <Icon name="arrowRight" class="arrow" />
      </a>
      <details class="group relative md:hidden" data-menu>
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-ink-1 hover:bg-surface-2 [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="menu" class="size-5 group-open:hidden" />
          <Icon name="close" class="hidden size-5 group-open:block" />
        </summary>
        <ul class="glass absolute top-12 right-0 w-56 rounded-3xl p-2">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-11 items-center rounded-2xl px-4 text-[15px] font-medium text-ink-1 hover:bg-surface-2"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>
